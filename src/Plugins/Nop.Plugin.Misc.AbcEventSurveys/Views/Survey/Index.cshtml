@model SurveyPageModel

@using Nop.Services.Media
@inject IPictureService PictureService

@{
    Layout = "_ColumnsOne";
    NopHtml.AddTitleParts(Model.Header1 ?? "Event Survey");
}

<style>
    .survey-page {
        max-width: 720px;
        margin: 0 auto;
        padding: 24px 16px 60px;
    }

    .survey-header1 {
        text-align: center;
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .survey-header2 {
        text-align: center;
        font-size: 1.25rem;
        color: #555;
        margin-bottom: 20px;
    }

    .survey-description {
        margin-bottom: 24px;
        line-height: 1.5;
    }

    .survey-page .form-group {
        margin-bottom: 16px;
    }

    .survey-name-row {
        display: flex;
        gap: 16px;
    }

    .survey-name-row .form-group {
        flex: 1 1 0;
        min-width: 0;
    }

    @@media (max-width: 480px) {
        .survey-name-row {
            flex-direction: column;
            gap: 0;
        }
    }

    .survey-page label {
        font-weight: bold;
        display: block;
        margin-bottom: 4px;
    }

    .survey-page .required-field::after {
        content: " *";
        color: red;
    }

    .survey-page input[type="text"],
    .survey-page input[type="email"],
    .survey-page input[type="tel"] {
        width: 100%;
        max-width: 100%;
        padding: 8px;
        box-sizing: border-box;
    }

    .survey-terms {
        margin: 24px 0;
        padding: 16px;
        border: 1px solid #ddd;
        background: #f9f9f9;
        font-size: 0.85rem;
        line-height: 1.5;
        max-height: 220px;
        overflow-y: auto;
    }

    .survey-terms-custom {
        white-space: pre-line;
    }

    .survey-consent-row {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin: 16px 0;
    }

    .survey-consent-row input[type="checkbox"] {
        margin-top: 4px;
    }

    .survey-submit {
        border: none;
        background-color: #f74258;
        color: #fff;
        padding: 15px 30px;
        font-size: 14px;
        font-weight: bold;
        text-transform: uppercase;
        outline: 1px solid transparent;
        transition: all 0.2s ease;
    }

    .survey-submit:hover {
        outline-color: #f74258;
    }

    .field-validation-error {
        color: #b00020;
        font-size: 0.85rem;
        display: block;
        margin-top: 4px;
    }

    .survey-closed,
    .survey-thankyou {
        text-align: center;
        padding: 60px 16px;
        font-size: 1.1rem;
    }

    .survey-thankyou {
        animation: surveyThankYouFadeIn 0.5s ease-out;
    }

    .survey-thankyou-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 16px;
    }

    .survey-thankyou-icon svg {
        width: 100%;
        height: 100%;
    }

    .survey-thankyou-icon circle {
        fill: none;
        stroke: #2e7d32;
        stroke-width: 3;
        stroke-dasharray: 158;
        stroke-dashoffset: 158;
        animation: surveyCheckCircle 0.6s ease-out forwards;
    }

    .survey-thankyou-icon path {
        fill: none;
        stroke: #2e7d32;
        stroke-width: 4;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
        animation: surveyCheckMark 0.4s 0.5s ease-out forwards;
    }

    @@keyframes surveyThankYouFadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes surveyCheckCircle {
        to {
            stroke-dashoffset: 0;
        }
    }

    @@keyframes surveyCheckMark {
        to {
            stroke-dashoffset: 0;
        }
    }

    .survey-picture {
        text-align: center;
        margin-bottom: 16px;
    }

    .survey-picture img {
        max-width: 100%;
        height: auto;
    }
</style>

<div class="survey-page">
    @if (Model.Submitted)
    {
        <div class="survey-thankyou">
            <div class="survey-thankyou-icon">
                <svg viewBox="0 0 52 52">
                    <circle cx="26" cy="26" r="25" />
                    <path d="M14 27l7.5 7.5L38 17" />
                </svg>
            </div>
            <h1>@(string.IsNullOrWhiteSpace(Model.ThankYouHeader) ? "Thank You!" : Model.ThankYouHeader)</h1>
            <p>@(string.IsNullOrWhiteSpace(Model.ThankYouDescription) ? "Your entry has been received. Good luck!" : Model.ThankYouDescription)</p>
        </div>

        @await Component.InvokeAsync("Widget", new { widgetZone = "SurveyThankYou" })
    }
    else if (Model.EventClosed)
    {
        <div class="survey-closed">
            <h1>This survey isn't currently accepting entries.</h1>
            <p>Please check back later or see an ABC Warehouse associate for details.</p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Model.Header1))
        {
            <div class="survey-header1">@Model.Header1</div>
        }
        @if (Model.PictureId > 0)
        {
            <div class="survey-picture">
                <img src="@await PictureService.GetPictureUrlAsync(Model.PictureId)" alt="@Model.Header1" />
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Header2))
        {
            <div class="survey-header2">@Model.Header2</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="survey-description">@Model.Description</div>
        }

        <form asp-controller="Survey" asp-action="Index" asp-route-code="@Model.Code" method="post">
            <div class="survey-name-row">
                <div class="form-group">
                    <label asp-for="FirstName" class="required-field"></label>
                    <nop-editor asp-for="FirstName" />
                    <span asp-validation-for="FirstName"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName" class="required-field"></label>
                    <nop-editor asp-for="LastName" />
                    <span asp-validation-for="LastName"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="required-field"></label>
                <nop-editor asp-for="Email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone" class="required-field"></label>
                <nop-editor asp-for="Phone" />
                <span asp-validation-for="Phone"></span>
            </div>

            @for (var i = 0; i < Model.CustomFields.Count; i++)
            {
                <div class="form-group">
                    <label class="@(Model.CustomFields[i].IsRequired ? "required-field" : "")">@Model.CustomFields[i].Name</label>
                    <input type="hidden" asp-for="CustomFields[i].Id" />
                    <input type="hidden" asp-for="CustomFields[i].Name" />
                    <input type="hidden" asp-for="CustomFields[i].IsRequired" />
                    <input type="text" asp-for="CustomFields[i].Value" />
                    <span asp-validation-for="CustomFields[i].Value"></span>
                </div>
            }

            <div class="survey-terms">
                @if (!string.IsNullOrWhiteSpace(Model.TermsAndConditions))
                {
                    <div class="survey-terms-custom">@Model.TermsAndConditions</div>
                }
                else
                {
                    <text><strong>Terms and Conditions:</strong> Terms and conditions apply. See an ABC Warehouse associate for
                    complete rules. Must be 18 years of age or older to enter. No purchase necessary. Limit one entry per
                    person. Duplicate entries will be disqualified. Winners will be selected at random from all eligible
                    entries received. Odds of winning depend on the total number of eligible entries received. Employees
                    of ABC Warehouse, its affiliates, and their immediate family members are not eligible to participate.
                    Winners are responsible for all applicable taxes. If a selected winner cannot be contacted, the prize
                    may be forfeited and awarded to an alternate winner. Promotion ends July 27, 2026, at 11:59 PM ET.
                    <br /><br />
                    By submitting this entry, you consent to receive marketing emails and promotional SMS text messages
                    from ABC Warehouse. Consent is not a condition of purchase. Message and data rates may apply. Message
                    frequency varies. Reply STOP to unsubscribe from SMS messages at any time or click the unsubscribe
                    link in marketing emails.</text>
                }
            </div>

            <div class="survey-consent-row">
                <input type="checkbox" asp-for="ConsentMarketing" id="ConsentMarketing" />
                <label for="ConsentMarketing" style="font-weight: normal; margin: 0;">
                    I have read and agree to the Terms and Conditions above.
                </label>
            </div>
            <span asp-validation-for="ConsentMarketing"></span>

            <input type="hidden" asp-for="SurveyEventId" />
            <input type="hidden" asp-for="Code" />
            <input type="hidden" asp-for="Header1" />
            <input type="hidden" asp-for="PictureId" />
            <input type="hidden" asp-for="Header2" />
            <input type="hidden" asp-for="Description" />

            <button type="submit" class="survey-submit">Submit Entry</button>
        </form>
    }
</div>
