@model SurveyEventModel

@inject INopHtmlHelper NopHtml

@{
    ViewBag.PageTitle = "Edit Event Survey";
    NopHtml.SetActiveMenuItemSystemName("ABCWarehouse.EventSurveys");

    Layout = "_AdminLayout";
}

<div class="content-header clearfix">
    <h1 class="pull-left">Edit Event Survey</h1>
    <div class="pull-right">
        <a asp-action="Responses" asp-route-id="@Model.Id" class="btn btn-info">
            <i class="fas fa-table"></i>
            View Responses (@Model.ResponseCount)
        </a>
        <a asp-action="List" class="btn btn-default">
            <i class="fas fa-arrow-circle-left"></i>
            Back to list
        </a>
    </div>
</div>

<div class="content">
    @if (!string.IsNullOrEmpty(Model.PublicUrl))
    {
        <div class="panel-group">
            <div class="panel panel-default">
                <div class="panel-body">
                    <strong>Public sign-up page:</strong>
                    <a href="@Model.PublicUrl" target="_blank">@Model.PublicUrl</a>
                </div>
            </div>
        </div>

        <div class="panel-group">
            <div class="panel panel-default">
                <div class="panel-heading">Tracked Link &amp; QR Code Builder</div>
                <div class="panel-body">
                    <p class="text-muted">
                        Build a link with UTM tags so each entry records where it came from (shown in the
                        Traffic Source column of the responses). Use a separate link per channel - e.g. one
                        for the email, one for the site popup, one QR code per store.
                    </p>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <label class="col-form-label" for="utmMedium">Medium (channel type)</label>
                        </div>
                        <div class="col-md-9">
                            <select id="utmMedium" class="form-control">
                                <option value="email">email - marketing emails</option>
                                <option value="sms">sms - text messages</option>
                                <option value="popup">popup - popups on abcwarehouse.com</option>
                                <option value="qr">qr - printed QR codes (signs, flyers, receipts)</option>
                                <option value="social">social - organic social posts</option>
                                <option value="paid-social">paid-social - paid social ads</option>
                                <option value="banner">banner - banners on abcwarehouse.com</option>
                                <option value="print">print - mailers / newspaper inserts</option>
                            </select>
                            <small class="form-text text-muted">
                                How they got the link. Examples: <code>email</code>, <code>sms</code>,
                                <code>popup</code>, <code>qr</code>.
                            </small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <label class="col-form-label" for="utmSource">Source (who sent them)</label>
                        </div>
                        <div class="col-md-9">
                            <input type="text" id="utmSource" class="form-control" list="utmSourceOptions" />
                            <datalist id="utmSourceOptions">
                                <option value="listrak"></option>
                                <option value="site"></option>
                                <option value="store"></option>
                                <option value="facebook"></option>
                                <option value="instagram"></option>
                                <option value="tiktok"></option>
                                <option value="flyer"></option>
                                <option value="mailer"></option>
                            </datalist>
                            <small class="form-text text-muted">
                                Who or where sent them. Examples: <code>listrak</code> (email/text),
                                <code>site</code> (popup), <code>store</code> or <code>store-taylor</code> (QR code).
                            </small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <label class="col-form-label" for="utmResult">Tracked link</label>
                        </div>
                        <div class="col-md-9">
                            <div class="input-group">
                                <input type="text" id="utmResult" class="form-control" readonly />
                                <div class="input-group-append">
                                    <button type="button" id="utmCopy" class="btn btn-default">
                                        <i class="far fa-copy"></i>
                                        Copy
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3">
                            <label class="col-form-label">QR code</label>
                        </div>
                        <div class="col-md-9">
                            <canvas id="utmQrCanvas" style="width: 200px; height: 200px; border: 1px solid #ddd;"></canvas>
                            <div class="mt-2">
                                <button type="button" id="utmDownloadPng" class="btn btn-success">
                                    <i class="fas fa-download"></i>
                                    Download PNG
                                </button>
                                <button type="button" id="utmDownloadSvg" class="btn btn-default">
                                    <i class="fas fa-download"></i>
                                    Download SVG (for print)
                                </button>
                            </div>
                            <small class="form-text text-muted">
                                Scan it with your phone before printing to confirm it opens the tagged link.
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly"></div>
        <div class="panel-group">
            <div class="panel panel-default">
                <div class="panel-heading">Event Details</div>
                <div class="panel-body">
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Name" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Name" />
                            <span asp-validation-for="Name"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Code" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Code" />
                            <small class="form-text text-muted">
                                Changing this changes the public URL - existing links/QR codes
                                using the old code will stop working.
                            </small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Header1" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Header1" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="PictureId" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="PictureId" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Header2" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Header2" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Description" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Description" asp-template="RichEditor" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="TermsAndConditions" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="TermsAndConditions" asp-template="RichEditor" />
                            <small class="form-text text-muted">
                                Leave blank to use the standard ABC Warehouse sweepstakes Terms and Conditions.
                            </small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="ThankYouHeader" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="ThankYouHeader" />
                            <small class="form-text text-muted">Leave blank to use "Thank You!".</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="ThankYouDescription" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="ThankYouDescription" asp-template="RichEditor" />
                            <small class="form-text text-muted">Leave blank to use the default "entry received" message.</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="IsActive" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="IsActive" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="EndDateUtc" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="EndDateUtc" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <button type="submit" class="btn bg-blue">Save</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="panel-group">
        <div class="panel panel-default">
            <div class="panel-heading">Custom Fields</div>
            <div class="panel-body">
                <p class="text-muted">
                    Extra text fields shown on this event's survey page, in addition to
                    First Name, Last Name, Email, and Phone.
                </p>

                @if (Model.CustomFields.Any())
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Field Label</th>
                                <th>Required</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var field in Model.CustomFields)
                            {
                                <tr>
                                    <td>@field.Name</td>
                                    <td>@(field.IsRequired ? "Yes" : "No")</td>
                                    <td>
                                        <form asp-action="DeleteCustomField" method="post"
                                              onsubmit="return confirm('Remove this field? Past responses keep their answers, but the field will no longer appear on the form.');">
                                            <input type="hidden" name="id" value="@field.Id" />
                                            <input type="hidden" name="surveyEventId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="far fa-trash-can"></i>
                                                Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p><em>No custom fields yet.</em></p>
                }

                <form asp-action="AddCustomField" method="post" class="form-inline">
                    <input type="hidden" name="surveyEventId" value="@Model.Id" />
                    <div class="form-group mr-2">
                        <label class="mr-2" for="newFieldName">New field label</label>
                        <input type="text" id="newFieldName" name="name" class="form-control" required placeholder="e.g. T-Shirt Size" />
                    </div>
                    <div class="form-group mr-2">
                        <label class="mr-2" for="newFieldRequired">
                            <input type="checkbox" id="newFieldRequired" name="isRequired" value="true" />
                            Required
                        </label>
                    </div>
                    <button type="submit" class="btn bg-blue">
                        <i class="fas fa-plus-square"></i>
                        Add Field
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="panel-group">
        <div class="panel panel-default">
            <div class="panel-body">
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Delete this event and ALL of its responses? This cannot be undone.');">
                    <button type="submit" class="btn btn-danger">
                        <i class="far fa-trash-can"></i>
                        Delete This Event
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.PublicUrl))
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var baseUrl = @Html.Raw(Json.Serialize(Model.PublicUrl));
            var fileBaseName = @Html.Raw(Json.Serialize(Model.Code ?? "survey"));

            var mediumSelect = document.getElementById("utmMedium");
            var sourceInput = document.getElementById("utmSource");
            var resultInput = document.getElementById("utmResult");
            var canvas = document.getElementById("utmQrCanvas");

            // Suggested source for each medium, used until the user types their own.
            var defaultSourceByMedium = {
                "email": "listrak",
                "sms": "listrak",
                "popup": "site",
                "qr": "store",
                "social": "facebook",
                "paid-social": "facebook",
                "banner": "site",
                "print": "mailer"
            };
            var sourceEdited = false;

            // lowercase, spaces -> hyphens, drop anything else, so values group consistently in reports
            var clean = function (value) {
                return (value || "").trim().toLowerCase()
                    .replace(/\s+/g, "-")
                    .replace(/[^a-z0-9\-_]/g, "");
            };

            var buildUrl = function () {
                var params = new URLSearchParams();
                params.set("utm_source", clean(sourceInput.value) || "(not-set)");
                params.set("utm_medium", clean(mediumSelect.value));

                return baseUrl + (baseUrl.indexOf("?") === -1 ? "?" : "&") + params.toString();
            };

            var buildQr = function (url) {
                if (typeof qrcode === "undefined")
                    return null;

                var qr = qrcode(0, "M");
                qr.addData(url);
                qr.make();
                return qr;
            };

            // Draws at a high resolution so the downloaded PNG prints sharply.
            var drawQr = function (qr) {
                var ctx = canvas.getContext("2d");
                if (!qr) {
                    canvas.width = canvas.height = 200;
                    ctx.clearRect(0, 0, 200, 200);
                    ctx.fillText("QR library failed to load", 10, 100);
                    return;
                }

                var moduleCount = qr.getModuleCount();
                var margin = 4;
                var cellSize = 20;
                var size = (moduleCount + margin * 2) * cellSize;

                canvas.width = canvas.height = size;
                ctx.fillStyle = "#ffffff";
                ctx.fillRect(0, 0, size, size);
                ctx.fillStyle = "#000000";

                for (var row = 0; row < moduleCount; row++) {
                    for (var col = 0; col < moduleCount; col++) {
                        if (qr.isDark(row, col))
                            ctx.fillRect((col + margin) * cellSize, (row + margin) * cellSize, cellSize, cellSize);
                    }
                }
            };

            var fileName = function (extension) {
                return [fileBaseName, clean(sourceInput.value), clean(mediumSelect.value)]
                    .filter(Boolean).join("-") + "." + extension;
            };

            var download = function (href, name) {
                var link = document.createElement("a");
                link.href = href;
                link.download = name;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            };

            var update = function () {
                var url = buildUrl();
                resultInput.value = url;
                drawQr(buildQr(url));
            };

            mediumSelect.addEventListener("change", function () {
                if (!sourceEdited)
                    sourceInput.value = defaultSourceByMedium[mediumSelect.value] || "";
                update();
            });
            sourceInput.addEventListener("input", function () {
                sourceEdited = sourceInput.value.length > 0;
                update();
            });

            document.getElementById("utmCopy").addEventListener("click", function () {
                var button = this;
                var showCopied = function () {
                    var original = button.innerHTML;
                    button.innerHTML = '<i class="fas fa-check"></i> Copied';
                    setTimeout(function () { button.innerHTML = original; }, 1500);
                };

                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(resultInput.value).then(showCopied);
                } else {
                    resultInput.select();
                    document.execCommand("copy");
                    showCopied();
                }
            });

            document.getElementById("utmDownloadPng").addEventListener("click", function () {
                download(canvas.toDataURL("image/png"), fileName("png"));
            });

            document.getElementById("utmDownloadSvg").addEventListener("click", function () {
                var qr = buildQr(resultInput.value);
                if (!qr)
                    return;

                var svg = qr.createSvgTag({ cellSize: 10, margin: 40, scalable: true });
                var blob = new Blob([svg], { type: "image/svg+xml" });
                var objectUrl = URL.createObjectURL(blob);
                download(objectUrl, fileName("svg"));
                setTimeout(function () { URL.revokeObjectURL(objectUrl); }, 1000);
            });

            sourceInput.value = defaultSourceByMedium[mediumSelect.value];
            update();
        });
    </script>
}
