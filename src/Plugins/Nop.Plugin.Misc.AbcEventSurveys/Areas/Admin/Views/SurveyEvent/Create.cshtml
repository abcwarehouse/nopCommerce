@model SurveyEventModel

@inject INopHtmlHelper NopHtml

@{
    ViewBag.PageTitle = "Create Event Survey";
    NopHtml.SetActiveMenuItemSystemName("ABCWarehouse.EventSurveys");

    Layout = "_AdminLayout";
}

<div class="content-header clearfix">
    <h1 class="pull-left">Create Event Survey</h1>
    <div class="pull-right">
        <a asp-action="List" class="btn btn-default">
            <i class="fas fa-arrow-circle-left"></i>
            Back to list
        </a>
    </div>
</div>

<div class="content">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="panel-group">
            <div class="panel panel-default">
                <div class="panel-body">
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Name" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Name" />
                            <span asp-validation-for="Name"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Code" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Code" />
                            <small class="form-text text-muted">
                                Leave blank to auto-generate from the name. This becomes the public
                                URL (/survey/{code}) and the identifier stamped on every response.
                            </small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Header1" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Header1" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Header2" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Header2" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="Description" />
                        </div>
                        <div class="col-md-9">
                            <nop-textarea asp-for="Description" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="IsActive" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="IsActive" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="StartDateUtc" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="StartDateUtc" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="EndDateUtc" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="EndDateUtc" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <button type="submit" class="btn bg-blue">
                                Save (you'll add custom fields on the next screen)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
