@using Nop.Web.Framework.UI
@using Nop.Core.Domain.Seo
@using System.Linq
@using System.Text.Json

@inject INopHtmlHelper NopHtml
@inject IWebHelper webHelper
@inject SeoSettings seoSettings

@{
    Layout = "_ColumnsOne";
    var storepointScript = ViewData["StorepointScript"] as string;
    var storepointScriptUrl = ViewData["StorepointScriptUrl"] as string;
    var storepointLocations = ViewData["StorepointLocations"] as IEnumerable<AbcWarehouse.Plugin.Misc.StorepointStoreLocator.Controllers.StoreLocatorController.StorepointLocation>;

    //title
    NopHtml.AddTitleParts("ABC Warehouse Locations - Stores in Michigan, Ohio & Indiana");
    //meta
    NopHtml.AddMetaDescriptionParts("Find your nearest ABC Warehouse store. 40+ locations across Michigan, Ohio & Indiana with appliances, TVs, mattresses, furniture & electronics in stock.");
    //og and twitter
    NopHtml.AddHeadCustomParts("<meta property=\"og:title\" content=\"ABC Warehouse Locations - Stores in Michigan, Ohio & Indiana\" />");
    NopHtml.AddHeadCustomParts("<meta property=\"og:description\" content=\"Find your nearest ABC Warehouse store. 40+ locations across Michigan, Ohio & Indiana with appliances, TVs, mattresses, furniture & electronics in stock.\" />");
    NopHtml.AddHeadCustomParts("<meta property=\"og:type\" content=\"website\" />");
    NopHtml.AddHeadCustomParts("<meta property=\"og:url\" content=\"https://www.abcwarehouse.com/store-locator\" />");
    NopHtml.AddHeadCustomParts("<meta name=\"twitter:card\" content=\"summary\" />");
    NopHtml.AddHeadCustomParts("<meta name=\"twitter:title\" content=\"ABC Warehouse Locations - Stores in Michigan, Ohio & Indiana\" />");
    NopHtml.AddHeadCustomParts("<meta name=\"twitter:description\" content=\"Find your nearest ABC Warehouse store. 40+ locations across Michigan, Ohio & Indiana with appliances, TVs, mattresses, furniture & electronics in stock.\" />");

    //canonical
    if (seoSettings.CanonicalUrlsEnabled)
    {
        NopHtml.AddCanonicalUrlParts("https://www.abcwarehouse.com/store-locator", false);
    }
}

<style>
    .storepoint-locations-ssr {
        margin-top: 2rem;
    }

    .storepoint-location-ssr-item {
        padding: 1rem;
        border-bottom: 1px solid #ccc;
    }
</style>

@{
    // JSON-LD structured data - simplified to avoid @ escaping issues
    string organizationJson = "{" +
        "\"@context\":\"https://schema.org\"," +
        "\"@type\":\"Organization\"," +
        "\"name\":\"ABC Warehouse\"," +
        "\"url\":\"https://www.abcwarehouse.com\"," +
        "\"description\":\"ABC Warehouse sells appliances, TVs, mattresses, furniture and electronics across Michigan, Ohio & Indiana\"," +
        "\"areaServed\":[\"Michigan\",\"Ohio\",\"Indiana\"]," +
        "\"numberOfLocations\":" + (storepointLocations?.Count() ?? 0) + "," +
        "\"sameAs\":[\"https://www.facebook.com/abcwarehouse\",\"https://www.youtube.com/abcwarehouse\"]" +
        "}";
}

<script type="application/ld+json">
@Html.Raw(organizationJson)
</script>

@if (storepointLocations != null && storepointLocations.Any())
{
    var locations = storepointLocations.ToList();
    var itemElements = new System.Collections.Generic.List<string>();

    foreach (var loc in locations)
    {
        var item = "{" +
            "\"@type\":\"LocalBusiness\"," +
            "\"name\":\"" + (loc.Name ?? "").Replace("\"", "\\\"") + "\"," +
            "\"address\":{" +
                "\"@type\":\"PostalAddress\"," +
                "\"streetAddress\":\"" + (loc.StreetAddress ?? "").Replace("\"", "\\\"") + "\"," +
                "\"addressLocality\":\"" + (loc.City ?? "").Replace("\"", "\\\"") + "\"," +
                "\"addressRegion\":\"" + (loc.State ?? "").Replace("\"", "\\\"") + "\"," +
                "\"postalCode\":\"" + (loc.PostalCode ?? "").Replace("\"", "\\\"") + "\"," +
                "\"addressCountry\":\"US\"" +
            "}," +
            "\"telephone\":\"" + (loc.Phone ?? "").Replace("\"", "\\\"") + "\"" +
            "}";
        itemElements.Add(item);
    }

    var itemListJson = "{" +
        "\"@context\":\"https://schema.org\"," +
        "\"@type\":\"ItemList\"," +
        "\"numberOfItems\":" + locations.Count + "," +
        "\"itemListElement\":[" + string.Join(",", itemElements) + "]" +
        "}";

    <script type="application/ld+json">
    @Html.Raw(itemListJson)
    </script>
}

<div class="page store-locator-page">
    <div class="page-title">
        <h1>ABC Warehouse Store Locations in Michigan, Ohio & Indiana</h1>
    </div>
    <div class="page-body">
        <div id="storepoint-container" data-map-id="15faae969dbf06"></div>

        <script>(function(){var a=document.createElement("script");a.type="text/javascript";a.async=!0;a.src="https://cdn.storepoint.co/api/v1/js/15faae969dbf06.js";var b=document.getElementsByTagName("script")[0];b.parentNode.insertBefore(a,b);}());</script>

        @if (storepointLocations != null && storepointLocations.Any())
        {
            <section class="storepoint-locations-ssr" aria-label="Store locations">
                <h2>Store Locations</h2>
                <ul class="storepoint-locations-ssr-list">
                    @foreach (var location in storepointLocations)
                    {
                        <li class="storepoint-location-ssr-item">
                            @if (!string.IsNullOrWhiteSpace(location.Name))
                            {
                                <strong>@location.Name</strong>
                            }
                            @if (!string.IsNullOrWhiteSpace(location.StreetAddress))
                            {
                                <div>@location.StreetAddress</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(location.City) || !string.IsNullOrWhiteSpace(location.State) || !string.IsNullOrWhiteSpace(location.PostalCode))
                            {
                                <div>@string.Join(", ", new[] { location.City, location.State }.Where(s => !string.IsNullOrWhiteSpace(s))) @location.PostalCode</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(location.Phone))
                            {
                                <div><a href="tel:@location.Phone">@location.Phone</a></div>
                            }
@if (!string.IsNullOrWhiteSpace(location.Website)
    && Uri.TryCreate(location.Website, UriKind.Absolute, out var websiteUri)
    && (websiteUri.Scheme == Uri.UriSchemeHttp || websiteUri.Scheme == Uri.UriSchemeHttps))
{
    <div><a href="@websiteUri.AbsoluteUri" rel="noopener">Visit Website</a></div>
}
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
</div>