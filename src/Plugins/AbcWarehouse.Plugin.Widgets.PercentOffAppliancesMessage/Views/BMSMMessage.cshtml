@model (decimal Price, bool IsOver596)

@inject INopHtmlHelper NopHtml

@{
    NopHtml.AddCssFileParts("~/Plugins/Widgets.PercentOffAppliancesMessage/styles/style.css");
}

<div id="percent-off-appliances-message" class="percent-off" style="font-weight: bold;">        
        @{
            if(Model.IsOver596)
            {
                <div class="in-store-container">
                    <div class="left-in-store">
                        <div class="left-store-text">
                            GET THE BEST<br />
                            DEAL IN STORE!
                        </div>
                    </div>
                    <div class="right-in-store">
                        <div class="right-store-text">
                            SAVE AN ADDITIONAL $50 OFF! <br />
                            <span>PAY ONLY $@(Model.Price)</span> <a href="/policies-information#savings" target="_blank">
                            <span class="learn-more-text">Learn More</span></a>
                            <i class="rebate-text">*After $50 mail in rebate</i>
                        </div>
                    
                    </div>
                </div>
            }
            else
            {
                <div class="in-store-container">
                    <div class="left-in-store">
                        <div class="left-store-text">
                            GET THE BEST<br />
                            DEAL IN STORE!
                        </div>
                    </div>
                    <div class="right-in-store">
                        <div class="right-store-text">
                            SAVE AN ADDITIONAL 5% OFF! <br />
                            <span>PAY ONLY $@(Model.Price)</span> <a href="/policies-information#savings" target="_blank">
                            <span class="learn-more-text">Learn More</span></a>
                        </div>
                    
                    </div>
                </div>
            }

        }
</div>