    .mobile-filter-button {
        display: none;
        width: 100%;
        padding: 12px 16px;
        margin-bottom: 15px;
        background: #d32f2f;
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
