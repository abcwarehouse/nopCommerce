@model DealsPageModel

@using Nop.Core.Domain.Common
@using Nop.Core.Domain.Seo
@using Nop.Plugin.Misc.AbcCore.Services
@using Microsoft.AspNetCore.Mvc.ViewComponents
@using Nop.Web.Framework.Infrastructure
@using Nop.Web.Extensions
@using Nop.Plugin.Misc.AbcPromos.Models
@using Nop.Plugin.Misc.AbcCore.Infrastructure
@using Nop.Core.Infrastructure;
@using Nop.Web.Models.Catalog;
@using Nop.Services.Catalog;
@using Nop.Web.Framework.UI;

@inject Nop.Core.IWebHelper webHelper
@inject SeoSettings seoSettings
@inject CommonSettings commonSettings
@inject IViewComponentSelector viewComponentSelector
@inject INopHtmlHelper NopHtml

@{
    Layout = "_ColumnsTwo";

    //title
    NopHtml.AddTitleParts("Deals");

    //page class
    NopHtml.AppendPageCssClassParts("html-deals-page");
}

<div class="page deals-page">
    <!-- Banner Section -->
    <div class="deals-banner-placeholder">
        <div class="deals-banner-content">
            <p>Promotional Banner Space</p>
        </div>
    </div>

    <div class="page-body">
        <!-- Sorting Section (Main Content Area) -->
        @if (Model.Products.Count > 0 && Model.AllowProductSorting)
        {
            <div class="deals-sorting-section">
                <div class="product-sorting">
                    <label>@T("Catalog.OrderBy")</label>
                    <select id="products-orderby" onchange="applySorting(this.value);">
                        @foreach (var option in Model.AvailableSortOptions)
                        {
                            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                        }
                    </select>
                </div>
            </div>
        }

        <!-- Products Grid -->
        @if (Model.Products.Count > 0)
        {
            <div class="product-grid">
                <div class="item-grid">
                    @foreach (var product in Model.Products)
                    {
                        <div class="item-box">
                            @Html.Partial("_ProductBox", product)
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="no-results">
                <p>@T("Search.NothingFound")</p>
            </div>
        }

        <!-- Pagination -->
        @{
            var pager = Html.Pager(Model).QueryParam("pagenumber");
        }
        @if (!(await pager.IsEmpty()))
        {
            <div class="pager">
                @pager
            </div>
        }
        @await Component.InvokeAsync("Widget", new { widgetZone = PublicWidgetZones.CategoryDetailsBottom, additionalData = Model })
    </div>
</div>

<script type="text/javascript">
    function applyFilters() {
        var promoRadios = document.getElementsByName('promo-filter');
        var categoryRadios = document.getElementsByName('category-filter');

        var promo = '';
        var category = '';

        for (var i = 0; i < promoRadios.length; i++) {
            if (promoRadios[i].checked) {
                promo = promoRadios[i].value;
                break;
            }
        }

        for (var i = 0; i < categoryRadios.length; i++) {
            if (categoryRadios[i].checked) {
                category = categoryRadios[i].value;
                break;
            }
        }

        var url = '/deals';
        var params = [];

        if (promo) params.push('promo=' + encodeURIComponent(promo));
        if (category) params.push('category=' + encodeURIComponent(category));

        if (params.length > 0) {
            url += '?' + params.join('&');
        }

        window.location.href = url;
    }

    function applySorting(value) {
        var url = window.location.href.split('?')[0];
        var params = new URLSearchParams(window.location.search);

        if (value) {
            params.set('orderby', value);
        } else {
            params.delete('orderby');
        }

        var queryString = params.toString();
        if (queryString) {
            url += '?' + queryString;
        }

        window.location.href = url;
    }
</script>

<style type="text/css">
    /* Banner Placeholder */
    .deals-page .deals-banner-placeholder {
        width: 100%;
        height: 250px;
        background: #f0f0f0;
        border: 2px dashed #ccc;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .deals-page .deals-banner-content {
        text-align: center;
        color: #999;
        font-size: 16px;
        font-weight: 500;
    }

    /* Sidebar Filters */
    .deals-filters-sidebar {
        margin-bottom: 30px;
    }

    .deals-filters-sidebar .filter-block {
        border-bottom: 1px solid #e0e0e0;
        padding-bottom: 20px;
        margin-bottom: 20px;
    }

    .deals-filters-sidebar .filter-block:last-child {
        border-bottom: none;
    }

    .deals-filters-sidebar .filter-block h4 {
        margin-bottom: 15px;
        font-weight: bold;
        font-size: 14px;
        text-transform: uppercase;
    }

    .deals-filters-sidebar .filter-options {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .deals-filters-sidebar .filter-option {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .deals-filters-sidebar .filter-option input[type="radio"] {
        cursor: pointer;
    }

    .deals-filters-sidebar .filter-option label {
        cursor: pointer;
        margin: 0;
        font-size: 14px;
    }

    .deals-filters-sidebar .filter-option input[type="radio"]:hover + label {
        color: #0066cc;
    }

    /* Sorting Section */
    .deals-page .deals-sorting-section {
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e0e0e0;
    }

    .deals-page .product-sorting {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .deals-page .product-sorting label {
        margin: 0;
        font-weight: 500;
        white-space: nowrap;
    }

    .deals-page .product-sorting select {
        min-width: 200px;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
        cursor: pointer;
    }

    .deals-page .no-results {
        text-align: center;
        padding: 40px 20px;
        color: #666;
    }
</style>

<style type="text/css">
    @@media (max-width: 768px) {
        .deals-page .deals-banner-placeholder {
            height: 200px;
        }

        .deals-page .product-sorting {
            flex-direction: column;
            align-items: stretch;
        }

        .deals-page .product-sorting select {
            min-width: 100%;
        }
    }
</style>

@section AsidePageTitle {
    <div class="page-title">
        <h1>Deals</h1>
    </div>
}

@section left {
    <div class="deals-filters-sidebar">
        @if (Model.AvailablePromoFilters.Count > 1)
        {
            <div class="filter-block">
                <h4>Filter by Promo</h4>
                <div class="filter-options">
                    @foreach (var option in Model.AvailablePromoFilters)
                    {
                        <div class="filter-option">
                            <input type="radio" id="promo_@option.Value" name="promo-filter" value="@option.Value" @(option.Selected ? "checked" : "") onchange="applyFilters()" />
                            <label for="promo_@option.Value">@option.Text</label>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Model.AvailableCategoryFilters.Count > 1)
        {
            <div class="filter-block">
                <h4>Filter by Category</h4>
                <div class="filter-options">
                    @foreach (var option in Model.AvailableCategoryFilters)
                    {
                        <div class="filter-option">
                            <input type="radio" id="category_@option.Value" name="category-filter" value="@option.Value" @(option.Selected ? "checked" : "") onchange="applyFilters()" />
                            <label for="category_@option.Value">@option.Text</label>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
